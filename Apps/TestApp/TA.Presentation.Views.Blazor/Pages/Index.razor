@page "/"
@attribute [OptionalInteractiveAutoRenderMode]

<h1>@_value</h1>

Welcome to your new app.

<SurveyPrompt Title="How is Blazor working for you?" />
<SurveyPrompt Title="How is Blazor working for you!" />

@code {
    private String _value = "HELLO, WORLD!";

    [Injected]
    public required IService<ToLowerRequest, ToLowerRequest.Result> Service { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _value = (await Service.Execute(new ToLowerRequest(_value, default))).Value;
    }
}