@page "/"
@using RhoMicro.ApplicationFramework.Presentation.Models.Abstractions
@using RhoMicro.ApplicationFramework.Presentation.Views.Blazor.Components.Primitives
@attribute [OptionalInteractiveAutoRenderMode]

<h1>@_value</h1>

Welcome to your new app.

<SurveyPrompt Title="How is Blazor working for you?" />
<SurveyPrompt Title="How is Blazor working for you!" />

<InputGroup TValue="String"
            TError="String"
            Value="Model">
    <Input>
    <TextInput Value="Model.Input"
               ErrorTitleParse="static s => s"
               TError="String" />
    </Input>
    <Error>
        @context
    </Error>
</InputGroup>
<Button Value="Clear" />
<Display Value="Display" />

@code {
    private String _value = "HELLO, WORLD!";
    //TODO: fix dynamic components m8
    [Injected]
    public required IInputGroupModel<String, String> Model { get; set; }
    [Injected]
    public required IDisplayModel<String> Display { get; set; }
    [Injected]
    public required IToLowerService Service { get; set; }
    [Injected]
    public required IToUpperService Service2 { get; set; }
    [Injected]
    public required IButtonModel Clear { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _value = (await Service.ToLower(_value, default)).Value;
        }
        catch { }
        Clear.Label = "Clear";
        Clear.Clicked += (s, e) =>
        {
            Model.Input.Value = String.Empty;
            return Task.CompletedTask;
        };
        Model.Input.PropertyValueChanged += (_, args) =>
            Display.Value = args.As<String>()?.NewValue ?? String.Empty;
    }
}