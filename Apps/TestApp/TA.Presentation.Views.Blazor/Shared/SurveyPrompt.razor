@inherits RhoMicro.ApplicationFramework.Presentation.Views.Blazor.Abstractions.ComponentBase

<div class="alert alert-secondary mt-4" role="alert">
    <span class="oi oi-pencil mr-2" aria-hidden="true"></span>
    <strong class="@ClassNames">@Title</strong>

    <span class="text-nowrap">
        Please take our
        <a target="_blank" class="font-weight-bold" href="https://go.microsoft.com/fwlink/?linkid=2137916">brief survey</a>
    </span>
    and tell us what you think.
</div>

@code {
    // Demonstrates how a parent component can supply parameters
    [Parameter]
    public string Title { get; set; } = String.Empty;
    protected override void OnInitialized()
    {
        ClassNames = ClassNames.Add(["font-italic", ("text-danger text-danger text-monospace", () => Title is not [.., '?'])]);
        base.OnInitialized();
    }
}
