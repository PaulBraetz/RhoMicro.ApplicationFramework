@typeparam TInputGroup where TInputGroup : IInputGroupModel<TInput, TValue, TError>
@typeparam TInput where TInput : IInputModel<TValue, TError>
@typeparam TValue
@typeparam TError
@inherits ModelComponentBase<TInputGroup, IInputGroupSpecializedCssStyle>
@attribute [ConfigurableStyle<IInputGroupSpecializedCssStyle, InputGroupSpecializedCssStyleSettings>]


<div @attributes="Attributes">
    @Label
    @Input(Model.Input)
    @Description
    @if(Model.Input.Validity == InputValidityType.Invalid)
    {
        @Error(Model.Input.ErrorValue)
    }
</div>